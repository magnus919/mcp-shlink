# Required for running the server (see README > Configuration)
SHLINK_BASE_URL=https://shlink.example.com
SHLINK_API_KEY=your-api-key-here

# Optional
# Deployment environment name; appears in every structured log line
SHLINK_ENV=production

# Opt-in anonymous tool usage analytics (default: false)
SHLINK_ANALYTICS_ENABLED=false
# Optional HTTP collector for usage events
# SHLINK_ANALYTICS_ENDPOINT=https://collector.example.com/hook

# Opt-in Sentry error tracking (see README > Error tracking)
# SENTRY_DSN=

# Feature flags (all default to false; see src/mcp_shlink/features.py)
# FLAG_SHLINK_ANALYTICS_ENABLED=false
# FLAG_SHLINK_SOFT_DELETE_ENABLED=false
# FLAG_SHLINK_RETRY_5XX_ENABLED=false
